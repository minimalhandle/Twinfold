{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Twinfold",
  "mainBinaryName": "Twinfold",
  "version": "0.1.0",
  "identifier": "app.twinfold.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Twinfold",
        "width": 1180,
        "height": 760,
        "minWidth": 860,
        "minHeight": 540,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
